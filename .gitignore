# === System Files ===
# macOS generates .DS_Store files to store folder view options. Not needed in version control.
.DS_Store

# Windows creates Thumbs.db files to cache thumbnails of images. Also not needed in Git.
Thumbs.db


# === JetBrains IDE Configuration ===
# Ignore IDE configuration files generated by WebStorm or other JetBrains IDEs.
# These files are environment-specific and should not be included in version control.
.idea/

# Project module files generated by JetBrains IDEs (e.g., WebStorm, IntelliJ)
*.iml


# === Node.js Dependencies ===
# Ignore Node.js packages if npm or yarn is used to install libraries.
# These can be reinstalled at any time via package.json and are not source code.
node_modules/


# === External Libraries ===
# Folder to store manually downloaded JS libraries (e.g., Chart.js, JSZip).
# Not part of the source code and can be regenerated or re-downloaded if needed.
libs/


# === Build or Distribution Output ===
# Ignore directories that store compiled or bundled versions of the extension.
# These are usually generated when preparing the extension for deployment.
dist/
build/


# === Backup and Temporary Files ===
# Generic patterns for temporary or backup files that may be created by editors or OS.
*.zip       # Exported or packaged extension archives
*.mbz       # Moodle backup files uploaded by the user (not source code)
*.bak       # Editor or manual backup files
*.tmp       # Temporary files created during editing or script execution
